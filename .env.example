# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Sessions
SESSION_SECRET=your_super_secret_session_key_min_32_chars
JWT_SECRET=your_jwt_signing_key_min_32_chars

# Database Configuration
DATABASE_PATH=./data/dealforge.sqlite

# Payment Integration (Stripe Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_development
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_development
STRIPE_PRICE_PRO_MONTHLY=price_pro_test_placeholder
STRIPE_PRICE_LIFETIME=price_lifetime_test_placeholder

# Optional LLM API Key (Falls back to high-fidelity built-in rule engine)
OPENAI_API_KEY=
